--- /dev/null
+++ b/drivers/staging/fbtft/fb_st7735s.c
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * FB driver for the Sitronix ST7735S 128x128 panel used by MF68E.
+ * Initialization values are taken from the OEM Android DTB panel node.
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/bitops.h>
+#include "fbtft.h"
+
+#define DRVNAME "fb_st7735s"
+#define WIDTH 128
+#define HEIGHT 128
+#define X_OFFSET 2
+#define Y_OFFSET 3
+#define ST7735S_CASET 0x2A
+#define ST7735S_RASET 0x2B
+#define ST7735S_RAMWR 0x2C
+#define ST7735S_MADCTL 0x36
+
+static const s16 mf68e_init_sequence[] = {
+	/* OEM reset GPIO timing is applied by fbtft_reset(). */
+	-2, 120,
+	-1, 0x11,                         /* sleep out */
+	-1, 0xB1, 0x05, 0x3A, 0x3A,
+	-1, 0xB2, 0x05, 0x3A, 0x3A,
+	-1, 0xB3, 0x05, 0x3A, 0x3A, 0x05, 0x3A, 0x3A,
+	-1, 0xB4, 0x03,
+	-1, 0xC0, 0x62, 0x02, 0x04,
+	-1, 0xC1, 0xC0,
+	-1, 0xC2, 0xC0, 0xD0,
+	-1, 0xC3, 0x8D, 0xA0,
+	-1, 0xC4, 0x8D, 0xEE,
+	-1, 0xC5, 0x12,
+	-1, 0xE0, 0x03, 0x1B, 0x12, 0x11, 0x3F, 0x3A, 0x32, 0x34,
+	          0x2F, 0x2B, 0x30, 0x3A, 0x00, 0x01, 0x02, 0x05,
+	-1, 0xE1, 0x03, 0x1B, 0x12, 0x11, 0x32, 0x2F, 0x2A, 0x2F,
+	          0x2E, 0x2C, 0x35, 0x3F, 0x00, 0x00, 0x01, 0x05,
+	-1, ST7735S_MADCTL, 0xC8,
+	-1, 0x3A, 0x05,                     /* RGB565 */
+	-1, ST7735S_CASET, 0x00, 0x02, 0x00, 0x81,
+	-1, ST7735S_RASET, 0x00, 0x03, 0x00, 0x82,
+	-1, 0x29,                          /* display on */
+	-1, ST7735S_RAMWR,
+	-3
+};
+
+static void set_addr_win(struct fbtft_par *par, int xs, int ys, int xe, int ye)
+{
+	xs += X_OFFSET;
+	xe += X_OFFSET;
+	ys += Y_OFFSET;
+	ye += Y_OFFSET;
+
+	write_reg(par, ST7735S_CASET, xs >> 8, xs & 0xFF, xe >> 8, xe & 0xFF);
+	write_reg(par, ST7735S_RASET, ys >> 8, ys & 0xFF, ye >> 8, ye & 0xFF);
+	write_reg(par, ST7735S_RAMWR);
+}
+
+static int set_var(struct fbtft_par *par)
+{
+	/* OEM Android config uses MADCTL 0xC8 (MX | MY | BGR). */
+	write_reg(par, ST7735S_MADCTL, 0xC8);
+	return 0;
+}
+
+static struct fbtft_display display = {
+	.regwidth = 8,
+	.width = WIDTH,
+	.height = HEIGHT,
+	.bpp = 16,
+	.fps = 20,
+	.init_sequence = mf68e_init_sequence,
+	.fbtftops = {
+		.set_addr_win = set_addr_win,
+		.set_var = set_var,
+	},
+};
+
+FBTFT_REGISTER_DRIVER(DRVNAME, "sitronix,st7735s", &display);
+
+MODULE_ALIAS("spi:" DRVNAME);
+MODULE_ALIAS("platform:" DRVNAME);
+MODULE_ALIAS("spi:st7735s");
+MODULE_ALIAS("platform:st7735s");
+MODULE_DESCRIPTION("FB driver for the MF68E ST7735S LCD Controller");
+MODULE_LICENSE("GPL");
--- a/drivers/staging/fbtft/Kconfig
+++ b/drivers/staging/fbtft/Kconfig
@@ -39,6 +39,12 @@ config FB_TFT_AGM1264K_FL
 	help
 	  Generic Framebuffer support for AGM1264K-FL LCD display
 
+config FB_TFT_ST7735S
+	tristate "FB driver for the ST7735S LCD Controller"
+	depends on FB_TFT
+	help
+	  Framebuffer support for the MF68E ST7735S 128x128 LCD
+
 config FB_TFT_BD663474
 	tristate "FB driver for the BD663474 LCD Controller"
 	depends on FB_TFT
--- a/drivers/staging/fbtft/Makefile
+++ b/drivers/staging/fbtft/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_FB_TFT)             += fbtft.o
 fbtft-y                          += fbtft-core.o fbtft-sysfs.o fbtft-bus.o fbtft-io.o
 
 obj-$(CONFIG_FB_TFT_AGM1264K_FL) += fb_agm1264k-fl.o
+obj-$(CONFIG_FB_TFT_ST7735S)     += fb_st7735s.o
 obj-$(CONFIG_FB_TFT_BD663474)    += fb_bd663474.o
 obj-$(CONFIG_FB_TFT_HX8340BN)    += fb_hx8340bn.o
