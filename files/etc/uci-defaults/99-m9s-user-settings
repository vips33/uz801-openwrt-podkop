#!/bin/sh
# First-boot defaults for the Generic M9S build.

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.2.1'
uci -q set network.lan.netmask='255.255.255.0'

uci -q set luci.main.lang='en'
uci -q set system.@system[0].zonename='Asia/Hong_Kong'
uci -q set system.@system[0].timezone='HKT-8'

# Enable the first detected Wi-Fi radio and network.
uci -q set wireless.@wifi-device[0].disabled='0'
uci -q set wireless.@wifi-iface[0].disabled='0'

uci commit network
uci commit luci
uci commit system
uci commit wireless
exit 0
